# Server
PORT=8000
PUBLIC_URL=https://dispatch.your-domain.com
REQUIRE_LICENSE=true
# When HTTPS is terminated by a proxy (nginx/Caddy/Cloudflare), set this so the
# app trusts the proxy headers for rate limiting and the https redirect.
# TRUST_PROXY=true
# Reject plain-HTTP requests. Requires TLS termination in front of the app.
# HTTPS_ONLY=true
# Extra origins allowed for CORS (comma-separated), e.g.
# https://dispatch.your-domain.com,https://admin.your-domain.com
# CORS_ORIGINS=
# Global per-IP API rate limit per minute (default 300).
# GLOBAL_RATE_LIMIT=300

# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email delivery (required for registration/reset emails). Use any SMTP
# provider (Mailgun, Postmark, SendGrid, or your own SMTP server).
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="RZ Dispatch <no-reply@your-domain.com>"

# SMS delivery (optional). Without this the "SMS alerts" preference is shown as
# unavailable instead of silently doing nothing. Twilio is the built-in provider.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# Default country code applied to bare 10-digit numbers (default: 1).
# SMS_DEFAULT_COUNTRY_CODE=1

# Quote distance routing (optional). Without a provider the app falls back to a
# straight-line haversine estimate (labelled "estimate" in the API response).
# Supported providers: openrouteservice | mapbox | osrm
# ROUTING_PROVIDER=openrouteservice
# ROUTING_API_KEY=your_provider_key
# Override the provider base URL (e.g. a self-hosted OSRM instance).
# ROUTING_BASE_URL=https://router.project-osrm.org

# API keys and outbound webhooks need no configuration. Create keys and
# webhook subscriptions from Settings -> API keys & webhooks. Deliveries are
# signed with HMAC-SHA256 in the X-RZ-Signature header (t=<unix>,v1=<hex>).

# Admin and operator demo accounts (change these before selling!)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace_with_a_strong_password
OPERATOR_EMAIL=operator@your-domain.com
OPERATOR_PASSWORD=replace_with_operator_password

# PostgreSQL
# Either set a full connection string, or individual PG* variables.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rz_dispatch
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rz_dispatch
PGUSER=postgres
PGPASSWORD=postgres
# Set to true when connecting to managed Postgres (Render/Railway/Fly.io) over SSL.
# PGSSL=false
# Max connections in the pool (default 10).
# PG_POOL_MAX=10

# Optional demo key used for local testing only; leave blank in production.
DEMO_LICENSE_KEY=

# Lifetime purchase price in the smallest currency unit (49900 = $499.00)
LIFETIME_PRICE_CENTS=49900
LIFETIME_CURRENCY=usd

# Stripe keys from your Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
